Bundle-Name: TOTP Authenticator
Bundle-SymbolicName: com.monapp.totp.authenticator
Bundle-Version: 1.0.34

-metatype: *
-plugin.metatype: com.liferay.ant.bnd.metatype.MetatypePlugin
-plugin.resourcebundle: com.liferay.ant.bnd.resource.bundle.ResourceBundleLoaderAnalyzerPlugin
Provide-Capability:\
	liferay.language.resources;\
		resource.bundle.base.name="content.Language"

-includeresource: \
    @googleauth-1.5.0.jar,\
    @commons-codec-1.15.jar,\
    @javase-3.5.1.jar,\
    @core-3.5.1.jar,\
    @jcommander-1.82.jar,\
    @jbcrypt-0.4.jar

Import-Package: \
    !com.warrenstrange.googleauth,\
    !org.apache.commons.codec.*,\
    !com.google.zxing,\
    !com.google.zxing.*,\
    !com.beust.jcommander,\
    !com.beust.jcommander.*,\
    !org.mindrot.jbcrypt,\
    !org.apache.avalon.framework.logger,\
    !org.apache.avalon.framework.logger.*,\
    !org.apache.log,\
    !org.apache.log4j,\
    !org.apache.log4j.*,\
    !org.ietf.jgss,\
    *
Export-Package: \
	com.monapp.totp.service,\
	com.monapp.totp.util
